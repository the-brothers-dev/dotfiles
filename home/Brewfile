# ============================================================
# Brewfile - Mac 개발 환경 자동 세팅
# Usage: brew bundle --file=Brewfile
# ============================================================

# ------ CLI: 기본 도구 ------
# Load/unload environment variables based on $PWD
brew "direnv"
# GitHub command-line tool
brew "gh"
# Graph visualization software from AT&T and Bell Labs
brew "graphviz"
# Fast, highly customisable system info script
brew "neofetch"
# Non-interactive ssh password auth
brew "sshpass"

# ------ Taps ------
tap "infisical/get-cli"

# ------ CLI: Dotfiles & 시크릿 관리 ------
# Manage your dotfiles across multiple machines
brew "chezmoi"
# Infisical CLI for secrets management
brew "infisical/get-cli/infisical"

# ------ CLI: Kubernetes ------
# Kubernetes command-line interface
brew "kubernetes-cli"
# Kubernetes package manager
brew "helm"
# Kubernetes CLI To Manage Your Clusters In Style!
brew "k9s"
# Run local Kubernetes cluster in Docker
brew "kind"
# Package manager for kubectl plugins
brew "krew"
# Kubernetes prompt info for bash and zsh
brew "kube-ps1"
# Colorize your kubectl output
brew "kubecolor"
# Tool that can switch between kubectl contexts easily and create aliases
brew "kubectx"

# ------ CLI: Zsh 플러그인 ------
# Fish-like fast/unobtrusive autosuggestions for zsh
brew "zsh-autosuggestions"
# Fish shell like syntax highlighting for zsh
brew "zsh-syntax-highlighting"

# ------ GUI Apps ------
# AI Coding Agent IDE
cask "antigravity"
# AI assistant desktop app
cask "claude"
# Terminal-based AI coding assistant
cask "claude-code"
# Voice and text chat for gamers
cask "discord"
# Web browser
cask "google-chrome"
# Terminal emulator as alternative to Apple's Terminal app
cask "iterm2"
# Note-taking and collaboration
cask "notion"
# Docker alternative - fast, light, simple
cask "orbstack"
# Mesh VPN based on WireGuard
cask "tailscale-app"
# Development environments made easy
cask "vagrant"
# Virtualizer for x86 hardware
cask "virtualbox"
