# ============================================================
# chezmoi 설정 파일
# 초기화 시 프롬프트로 입력받은 값들이 저장됨
# ============================================================

[data]
    email = {{ promptStringOnce . "email" "Git 이메일" | quote }}
    name = {{ promptStringOnce . "name" "Git 사용자 이름" | quote }}

[data.infisical]
    # Infisical 시크릿 관리 설정 (선택사항)
    enabled = {{ promptBoolOnce . "infisical.enabled" "Infisical 시크릿 관리 사용" }}
{{- if .infisical.enabled }}
    project_id = {{ promptStringOnce . "infisical.project_id" "Infisical 프로젝트 ID" | quote }}
    env = {{ promptStringOnce . "infisical.env" "Infisical 환경 (dev/staging/prod)" | quote }}
{{- end }}

[edit]
    command = "agy"
    args = ["--wait"]
