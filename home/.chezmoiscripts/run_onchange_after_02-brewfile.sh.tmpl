#!/bin/bash
# ============================================================
# Brewfile 패키지 설치
# Brewfile이 변경될 때마다 실행됨
# hash: {{ include "Brewfile" | sha256sum }}
# ============================================================
set -euo pipefail

BREWFILE="{{ .chezmoi.sourceDir }}/Brewfile"

if [ -f "$BREWFILE" ]; then
    echo "📦 Brewfile 패키지 확인 중..."

    if brew bundle check --file="$BREWFILE" &>/dev/null; then
        echo "✅ 모든 패키지가 이미 설치되어 있습니다"
    else
        echo "📥 누락된 패키지 설치 중..."
        brew bundle --file="$BREWFILE"
        echo "✅ Brewfile 설치 완료"
    fi
else
    echo "⚠️  Brewfile을 찾을 수 없습니다: $BREWFILE"
fi
