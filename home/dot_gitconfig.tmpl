# ============================================================
# .gitconfig - Git 기본 설정
# Managed by chezmoi - 직접 수정하지 마세요
# ============================================================

[user]
    name = {{ .name }}
    email = {{ .email }}
{{- if and .vault.enabled .vault.token }}
    # GPG 서명키는 Vault에서 가져옴
    # signingkey = {{ output "vault" "kv" "get" "-field=gpg_key" "secret/dotfiles" | trim }}
{{- end }}

[init]
    defaultBranch = main

[core]
    excludesfile = ~/.gitignore_global
    editor = agy --wait
    autocrlf = input

[pull]
    rebase = false

[push]
    default = current
    autoSetupRemote = true

[alias]
    st = status
    co = checkout
    br = branch
    ci = commit
    lg = log --oneline --graph --decorate

[color]
    ui = auto

# ============================================================
# 디렉토리별 Git 설정 (Conditional Includes)
# 각 디렉토리의 .gitconfig에서 user.name, user.email 오버라이드
# ============================================================
[includeIf "gitdir:~/Projects/personal/"]
    path = ~/Projects/personal/.gitconfig

[includeIf "gitdir:~/Projects/work/"]
    path = ~/Projects/work/.gitconfig

# 회사별 세분화 (하위 디렉토리가 우선)
[includeIf "gitdir:~/Projects/work/company-a/"]
    path = ~/Projects/work/company-a/.gitconfig

[includeIf "gitdir:~/Projects/work/company-b/"]
    path = ~/Projects/work/company-b/.gitconfig

[includeIf "gitdir:~/Projects/community/thebrothers/"]
    path = ~/Projects/community/thebrothers/.gitconfig
