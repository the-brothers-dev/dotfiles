# ------ Homebrew ------
if [ -f "/opt/homebrew/bin/brew" ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# ------ OrbStack (설치된 경우) ------
[ -f ~/.orbstack/shell/init.zsh ] && source ~/.orbstack/shell/init.zsh
