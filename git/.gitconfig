# ============================================================
# .gitconfig - Git 기본 설정
# user.name과 user.email은 bootstrap.sh에서 설정됨
# ============================================================

[init]
    defaultBranch = main

[core]
    excludesfile = ~/.gitignore_global
    editor = code --wait
    autocrlf = input

[pull]
    rebase = false

[push]
    default = current
    autoSetupRemote = true

[alias]
    st = status
    co = checkout
    br = branch
    ci = commit
    lg = log --oneline --graph --decorate

[color]
    ui = auto
