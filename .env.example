# 원격 Mac 접속 정보 (복사해서 .env로 저장)
REMOTE_USER="user"
REMOTE_HOST="192.168.0.100"
REMOTE_PASS="password"

# chezmoi 사용자 정보 (Git 설정에 사용)
CHEZMOI_NAME="Your Name"
CHEZMOI_EMAIL="your@email.com"

# SSH 키 자동 생성 (y/n)
CREATE_SSH_KEY="n"

# Claude Code API Key (Pro/Team 사용자)
ANTHROPIC_API_KEY=""

# Infisical 설정 (시크릿 관리)
INFISICAL_TOKEN=""              # 서비스 토큰 (머신 인증용)
INFISICAL_PROJECT_ID=""         # 프로젝트 ID
INFISICAL_ENV="dev"             # 환경 (dev, staging, prod)
INFISICAL_URL="https://app.infisical.com"  # 셀프 호스팅 시 변경
