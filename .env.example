# ============================================================
# Infisical 인증 정보 (부트스트랩용)
# 복사해서 .env로 저장하세요
#
# 다른 시크릿들은 Infisical에서 관리됩니다:
#   - REMOTE_USER, REMOTE_HOST, REMOTE_PASS
#   - CHEZMOI_NAME, CHEZMOI_EMAIL
#   - CREATE_SSH_KEY
#   - ANTHROPIC_API_KEY
# ============================================================

# Infisical Universal Auth (https://app.infisical.com에서 생성)
INFISICAL_CLIENT_ID=""
INFISICAL_CLIENT_SECRET=""

# Infisical 프로젝트 설정
INFISICAL_PROJECT_ID=""
INFISICAL_ENV="dev"
INFISICAL_URL="https://app.infisical.com"
