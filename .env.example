# 원격 Mac 접속 정보 (복사해서 .env로 저장)
REMOTE_USER="user"
REMOTE_HOST="192.168.0.100"
REMOTE_PASS="password"

# chezmoi 사용자 정보 (Git 설정에 사용)
CHEZMOI_NAME="Your Name"
CHEZMOI_EMAIL="your@email.com"

# SSH 키 자동 생성 (y/n)
CREATE_SSH_KEY="n"

# Claude Code API Key (Pro/Team 사용자)
ANTHROPIC_API_KEY=""

# Vault 설정 (시크릿 관리)
VAULT_ADDR="http://localhost:8200"
VAULT_TOKEN=""
VAULT_PATH="secret/data/dotfiles"
